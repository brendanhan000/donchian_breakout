# Schwab data comes from the central schwab_hub (../schwab_hub/run.sh); no credentials here.
# SCHWAB_HUB_URL=http://127.0.0.1:8765

# Server
# HOST=127.0.0.1
# PORT=8183

# Detector defaults (all overridable in the UI later; these are the single source of truth)
# DONCHIAN_ENTRY_N=20
# DONCHIAN_SLOW_N=55
# DONCHIAN_EXIT_N=10
# DONCHIAN_ATR_N=14
# DONCHIAN_VOLUME_N=20
# DONCHIAN_FALSE_BREAK_K=3

# Cache / fetch. Schwab serves ~270 days of 15m/30m bars (measured ~258) and ~47 days of 1m.
# DONCHIAN_DATA_DIR=data
# DONCHIAN_DAILY_HISTORY_YEARS=10
# DONCHIAN_INTRADAY_LOOKBACK_DAYS=270
# DONCHIAN_FETCH_WORKERS=8          # hub caps upstream concurrency at 8 (HUB_CONCURRENCY)

# Half-day sessions (13:00 ET close), comma-separated ISO dates. Extend each year.
# DONCHIAN_EARLY_CLOSES=2026-11-27,2026-12-24
